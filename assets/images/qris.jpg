<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <linearGradient id="grad_qrisjpg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#fff" />
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#1e293b" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#1e293b" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Background -->
  <rect width="500" height="500" fill="url(#grad_qrisjpg)" />
  <rect width="500" height="500" fill="url(#glow)" />

  <!-- Elegant Inner Border -->
  <rect x="20" y="20" width="460" height="460" rx="12" fill="none" stroke="#1e293b" stroke-width="1.5" stroke-opacity="0.4" stroke-dasharray="8 4"/>
  <rect x="28" y="28" width="444" height="444" rx="8" fill="none" stroke="#1e293b" stroke-width="0.8" stroke-opacity="0.3"/>

  <!-- Corner flourishes -->
  <circle cx="28" cy="28" r="4" fill="#1e293b" opacity="0.6"/>
  <circle cx="472" cy="28" r="4" fill="#1e293b" opacity="0.6"/>
  <circle cx="28" cy="472" r="4" fill="#1e293b" opacity="0.6"/>
  <circle cx="472" cy="472" r="4" fill="#1e293b" opacity="0.6"/>

  
  <!-- QR Code Mock Graphic -->
  <g transform="translate(140, 110)">
    <rect width="220" height="220" rx="10" fill="#ffffff" stroke="#e2e8f0" stroke-width="2"/>
    <!-- Position Marks -->
    <rect x="15" y="15" width="55" height="55" rx="4" fill="#1e293b"/>
    <rect x="25" y="25" width="35" height="35" rx="2" fill="#fff"/>
    <rect x="33" y="33" width="19" height="19" rx="1" fill="#1e293b"/>

    <rect x="150" y="15" width="55" height="55" rx="4" fill="#1e293b"/>
    <rect x="160" y="25" width="35" height="35" rx="2" fill="#fff"/>
    <rect x="168" y="33" width="19" height="19" rx="1" fill="#1e293b"/>

    <rect x="15" y="150" width="55" height="55" rx="4" fill="#1e293b"/>
    <rect x="25" y="160" width="35" height="35" rx="2" fill="#fff"/>
    <rect x="33" y="168" width="19" height="19" rx="1" fill="#1e293b"/>

    <!-- Data Pattern Grid -->
    <rect x="85" y="25" width="15" height="15" fill="#1e293b"/>
    <rect x="110" y="25" width="25" height="10" fill="#1e293b"/>
    <rect x="85" y="55" width="40" height="15" fill="#1e293b"/>
    <rect x="25" y="85" width="40" height="15" fill="#1e293b"/>
    <rect x="80" y="85" width="20" height="40" fill="#1e293b"/>
    <rect x="115" y="85" width="30" height="20" fill="#1e293b"/>
    <rect x="160" y="85" width="45" height="20" fill="#1e293b"/>
    <rect x="25" y="115" width="20" height="20" fill="#1e293b"/>
    <rect x="115" y="120" width="30" height="30" fill="#1e293b"/>
    <rect x="160" y="120" width="25" height="40" fill="#1e293b"/>
    <rect x="85" y="145" width="20" height="40" fill="#1e293b"/>
    <rect x="115" y="165" width="45" height="20" fill="#1e293b"/>
    <rect x="175" y="175" width="30" height="30" fill="#1e293b"/>

    <!-- Center Icon -->
    <circle cx="110" cy="110" r="18" fill="#fff" stroke="#1e293b" stroke-width="2"/>
    <text x="110" y="116" font-family="'Segoe UI', sans-serif" font-size="14" font-weight="bold" fill="#1e293b" text-anchor="middle">QRIS</text>
  </g>
  <text x="250" y="410" font-family="'Montserrat', sans-serif" font-size="16" font-weight="600" fill="#1e293b" text-anchor="middle">QRIS Pembayaran / Donasi</text>
  <text x="250" y="440" font-family="'Montserrat', sans-serif" font-size="13" fill="#64748b" text-anchor="middle">Scan dengan E-Wallet / Mobile Banking</text>
  
</svg>